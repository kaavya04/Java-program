import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] a = {3, 8, 12, 5, 6};
        int target = 14;

        for (int i = 0; i < a.length; i++) {
            for (int j = i + 1; j < a.length; j++) {

                if (a[i] + a[j] == target) {
                    System.out.println(a[i] + " + " + a[j] + " = " + target);
                }
            }
        }
    }
}
