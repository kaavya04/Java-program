//All Right angle triangel,left angle triangle,inverted right angle,inverted let angle triangle

class Main {
    public static void main(String[] args) {
      
      int n=5;
      for(int i=0;i<n;i++)
      {
        for(int j=0;j<n;j++)
        {
            if(i>=j)   //i>=j,i<=j,i+j>=n-1,i+j<=n-1
            {
                System.out.print("*");
            }
            else
            {
                System.out.print(" ");
            }
        }
        System.out.println();
      }




    }
}
