class c1
{
    public static void main(String [] args)
    {
        int factorial = 1;
        int number = 5; // Number to calculate factorial        
        for(int i = 1; i <= number; i++)
        {
            factorial *= i; // factorial = factorial * i;
        }
        System.out.println("Factorial of " + number + " is: " + factorial);
    }
}
