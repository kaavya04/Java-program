public class Main {
    public static void main(String[] args) {

        int[] a = {0, 1, 0, 3, 12};

        int index = 0;

        // Put all non-zero elements first
        for (int i = 0; i < a.length; i++) {
            if (a[i] != 0) {
                a[index] = a[i];
                index++;
            }
        }

        // Fill remaining positions with 0
        while (index < a.length) {
            a[index] = 0;
            index++;
        }

        // Print array
        for (int i = 0; i < a.length; i++) {
            System.out.print(a[i] + " ");
        }
    }
}
