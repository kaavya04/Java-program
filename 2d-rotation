import java.util.*;
import java.util.Arrays;
class Main{
    public static void main(String [] args)
    {
        int a[][]={{1,2,3},{4,5,6},{7,8,9}};
        int n=a.length;
        
        for(int i=0;i<a.length;i++)
        {
            for(int j=0;j<a[i].length;j++)
            {
             
                System.out.print(a[n-1-j][i]+" ");
            }
            System.out.println();
        }

    }
}
